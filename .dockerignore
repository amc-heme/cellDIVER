# Keep the Docker build context focused on the files the multi-stage Dockerfile
# now needs: package source for the final image, plus the shiny-server assets.
# Large or unrelated files stay excluded so cache invalidation remains narrow.

# Version control & CI
.git
.gitignore
.gitattributes
.github

# Package assets not needed for the runtime image build
data

# Docs, vignettes (large PNG/GIF assets), pkgdown output
docs
vignettes
_pkgdown.yml
*.Rmd
README.md
LICENSE

# Planning / scratch
cellDIVER_docker_plan.md
config.yaml
Rplots.pdf

# Posit Connect Cloud deploy app — published by the posit-connect-cloud
# workflow, not used by this image (which serves docker/shiny-server/ instead).
connect

# Editor / IDE / OS cruft
*.Rproj
.Rproj.user
.Rhistory
.RData
.editorconfig
.vscode
opencode.json
.DS_Store
**/.DS_Store
